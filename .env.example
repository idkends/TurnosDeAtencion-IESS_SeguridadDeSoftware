# Copia este archivo a .env y completa los valores con: python scripts/generar_env.py
# (el archivo .env NUNCA se sube al repositorio; aquí no hay valores secretos).

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_SECRET_KEY_FALLBACKS=
ALLOWED_HOSTS=
URL_BASE=
HSTS_SEGUNDOS=
HMAC_TOKENS_CLAVE=
TOTP_CLAVES_CIFRADO=
AUDITORIA_CLAVES=
AUDITORIA_VERSION_ACTUAL=

# --- Base de datos (tres roles de mínimo privilegio + uno solo para pruebas en desarrollo) ---
POSTGRES_PASSWORD=
DB_NAME=
DB_CLAVE=
DB_MIGRACIONES_CLAVE=
DB_AUDITORIA_RO_CLAVE=
DB_CLAVE_PRUEBAS=

# --- Redis ---
REDIS_CLAVE=

# --- Servicios externos simulados (secreto compartido para el token de servicio) ---
SERVICIOS_CLAVE_AFILIACION=

# --- Notificaciones simuladas: consola | archivo ---
NOTIFICACIONES_ADAPTADOR=
